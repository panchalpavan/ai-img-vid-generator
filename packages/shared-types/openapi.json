{
  "components": {
    "schemas": {
      "CheckoutRequest": {
        "description": "POST /billing/checkout body.",
        "properties": {
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          }
        },
        "required": [
          "pack_id"
        ],
        "title": "CheckoutRequest",
        "type": "object"
      },
      "CheckoutResponse": {
        "description": "The URL the browser should navigate to.",
        "properties": {
          "checkout_url": {
            "title": "Checkout Url",
            "type": "string"
          }
        },
        "required": [
          "checkout_url"
        ],
        "title": "CheckoutResponse",
        "type": "object"
      },
      "CompleteRequest": {
        "description": "Sent after the browser finishes the direct PUT.",
        "properties": {
          "content_type": {
            "maxLength": 128,
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "title": "Filename",
            "type": "string"
          },
          "key": {
            "maxLength": 512,
            "title": "Key",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 1.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "content_type",
          "size_bytes",
          "key"
        ],
        "title": "CompleteRequest",
        "type": "object"
      },
      "CreateGenerationRequest": {
        "description": "Request body for POST /generations.",
        "properties": {
          "inputs": {
            "$ref": "#/components/schemas/GenerationInput"
          },
          "model_id": {
            "description": "Must match a model returned by GET /models.",
            "title": "Model Id",
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "inputs"
        ],
        "title": "CreateGenerationRequest",
        "type": "object"
      },
      "DBHealthResponse": {
        "description": "Response shape for /healthz/db (readiness check including DB).",
        "properties": {
          "db": {
            "title": "Db",
            "type": "string"
          },
          "probe": {
            "title": "Probe",
            "type": "integer"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "db",
          "probe"
        ],
        "title": "DBHealthResponse",
        "type": "object"
      },
      "GenerationInput": {
        "description": "User-supplied inputs for a generation request.\n\nFields are all optional \u2014 which apply depends on the selected model's\ninput_types. Validation that the right fields are present happens in\nthe /generations endpoint.",
        "properties": {
          "image_urls": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Image Urls",
            "type": "array"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "title": "GenerationInput",
        "type": "object"
      },
      "GenerationResponse": {
        "description": "Public-facing shape of a Generation row.\n\nMirrors the DB columns we want to expose. Excludes user_id (already\nimplicit via auth) and inputs (already in `prompt` for Sprint 3).",
        "properties": {
          "cost_in_credits": {
            "title": "Cost In Credits",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "result_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Text"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          },
          "status": {
            "$ref": "#/components/schemas/GenerationStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "model_id",
          "prompt",
          "status",
          "result_text",
          "result_url",
          "error",
          "cost_in_credits",
          "created_at",
          "updated_at"
        ],
        "title": "GenerationResponse",
        "type": "object"
      },
      "GenerationStatus": {
        "description": "Lifecycle of a generation row.\n\nStored as VARCHAR for the same reason TransactionType is \u2014 Alembic\nmigrations of Postgres ENUMs are notoriously painful.",
        "enum": [
          "pending",
          "processing",
          "done",
          "failed"
        ],
        "title": "GenerationStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Response shape for /healthz (liveness check).",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InputType": {
        "description": "Kinds of input a model can accept.\n\nDrives the dynamic form on the frontend: each entry in\nModelConfig.input_types becomes a form field.",
        "enum": [
          "text",
          "image",
          "video"
        ],
        "title": "InputType",
        "type": "string"
      },
      "MeResponse": {
        "description": "Shape of GET /me.",
        "properties": {
          "balance": {
            "title": "Balance",
            "type": "integer"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "image_url",
          "balance"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ModelConfig": {
        "description": "Frontend-visible metadata about one model.\n\nReturned as a list from GET /models. The frontend uses this to:\n  - populate the model dropdown (display_name)\n  - render the right form fields (input_types)\n  - display the cost (cost_in_credits)\n  - decide whether to poll for an async result (is_async)",
        "properties": {
          "cost_in_credits": {
            "title": "Cost In Credits",
            "type": "integer"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_types": {
            "items": {
              "$ref": "#/components/schemas/InputType"
            },
            "title": "Input Types",
            "type": "array"
          },
          "is_async": {
            "title": "Is Async",
            "type": "boolean"
          },
          "output_type": {
            "$ref": "#/components/schemas/OutputType"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          }
        },
        "required": [
          "id",
          "provider",
          "display_name",
          "input_types",
          "output_type",
          "cost_in_credits",
          "is_async"
        ],
        "title": "ModelConfig",
        "type": "object"
      },
      "OutputType": {
        "description": "Kind of output a model produces.",
        "enum": [
          "text",
          "image",
          "video"
        ],
        "title": "OutputType",
        "type": "string"
      },
      "PackResponse": {
        "description": "One credit pack as the frontend sees it.\n\nExcludes the stripe_price_id because the browser never sends that \u2014\nit sends `pack_id` (our slug) instead. Keeps the Stripe-side\nidentifier out of the API contract.",
        "properties": {
          "credits": {
            "title": "Credits",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "price_cents": {
            "title": "Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name",
          "credits",
          "price_cents",
          "currency"
        ],
        "title": "PackResponse",
        "type": "object"
      },
      "PresignRequest": {
        "description": "What the browser sends to /references/presign before uploading.",
        "properties": {
          "content_type": {
            "maxLength": 128,
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "title": "Filename",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 1.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ],
        "title": "PresignRequest",
        "type": "object"
      },
      "PresignResponse": {
        "description": "Everything the browser needs to perform the direct PUT to R2.",
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "public_url": {
            "title": "Public Url",
            "type": "string"
          },
          "reference_id": {
            "format": "uuid",
            "title": "Reference Id",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "upload_url": {
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "reference_id",
          "upload_url",
          "public_url",
          "key",
          "content_type",
          "size_bytes",
          "expires_in_seconds"
        ],
        "title": "PresignResponse",
        "type": "object"
      },
      "ProviderName": {
        "description": "The AI services we can route to.",
        "enum": [
          "google-ai-studio",
          "vertex-ai",
          "sjinn",
          "pollinations",
          "cloudflare-workers-ai",
          "seegen"
        ],
        "title": "ProviderName",
        "type": "string"
      },
      "ReferenceResponse": {
        "description": "Public-facing shape of a Reference row.",
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "public_url": {
            "title": "Public Url",
            "type": "string"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "public_url",
          "filename",
          "content_type",
          "size_bytes",
          "created_at"
        ],
        "title": "ReferenceResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Backend for the img-vid-generation app.",
    "title": "img-vid-generation API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/billing/checkout": {
      "post": {
        "description": "Create a Stripe Checkout Session for the requested pack.\n\nReturns the hosted Stripe URL. The browser navigates there; Stripe\nhandles all card collection, 3DS, etc. On success/cancel, Stripe\nredirects back to `success_url` / `cancel_url` (configured here).\n\nThe webhook (NOT this endpoint) is what actually grants the credits.\nThis endpoint just sets up the session.",
        "operationId": "create_checkout_session_billing_checkout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Checkout Session",
        "tags": [
          "billing"
        ]
      }
    },
    "/billing/packs": {
      "get": {
        "description": "Return every configured credit pack, cheapest first.\n\nPublic \u2014 no auth required. The catalog is fixed and not user-specific,\nand exposing it lets a future logged-out landing page show pricing.",
        "operationId": "list_packs_billing_packs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PackResponse"
                  },
                  "title": "Response List Packs Billing Packs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Packs",
        "tags": [
          "billing"
        ]
      }
    },
    "/generations": {
      "get": {
        "description": "List the caller's generations, newest first.",
        "operationId": "list_generations_generations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GenerationResponse"
                  },
                  "title": "Response List Generations Generations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Generations",
        "tags": [
          "generations"
        ]
      },
      "post": {
        "description": "Submit a new generation. Returns immediately with status=pending.\n\nThe Celery worker picks up the row, charges credits, runs the provider,\nand lands it in done/failed. Clients poll `GET /generations/{id}` for\nupdates.",
        "operationId": "create_generation_generations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGenerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Generation",
        "tags": [
          "generations"
        ]
      }
    },
    "/generations/{generation_id}": {
      "get": {
        "description": "Fetch one generation. Returns 404 if it isn't the caller's row.",
        "operationId": "get_generation_generations__generation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "generation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Generation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Generation",
        "tags": [
          "generations"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness probe. Returns OK if the process is running.\n\nCheap \u2014 does not touch the database. Suitable for load-balancer\nliveness checks that fire every few seconds.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "meta"
        ]
      }
    },
    "/healthz/db": {
      "get": {
        "description": "Readiness probe. Verifies the database is reachable by running SELECT 1.\n\nMore expensive than /healthz \u2014 actually hits the DB. Use for readiness\nchecks that gate traffic, or as a smoke test during deploys.",
        "operationId": "healthz_db_healthz_db_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DBHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz Db",
        "tags": [
          "meta"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Return the authenticated user's profile + credit balance.\n\nDev bypass: if the user's email matches `DEV_EMAIL`, the reported\nbalance is effectively infinite. The actual `profiles.credit_balance`\nin the DB is unchanged \u2014 this is purely a read-time substitution so\nthe dev never has to top up credits while developing.",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "me"
        ]
      }
    },
    "/models": {
      "get": {
        "description": "Return every enabled model the frontend can offer.",
        "operationId": "list_models_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelConfig"
                  },
                  "title": "Response List Models Models Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/references": {
      "get": {
        "description": "List the caller's references, newest first.",
        "operationId": "list_references_references_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReferenceResponse"
                  },
                  "title": "Response List References References Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List References",
        "tags": [
          "references"
        ]
      }
    },
    "/references/presign": {
      "post": {
        "description": "Mint a signed PUT URL for the browser to upload directly to R2.",
        "operationId": "presign_reference_upload_references_presign_post",

# Copy this file to `.env` (no extension) and fill in real values.
# `.env` is gitignored — never commit secrets.
#
# Production note: at Sprint 7 deploy time, anything still set to a
# localhost URL must be swapped for the production frontend domain.
# Search this file for "localhost" to find them all.

# ---------------------------------------------------------------------------
# Database (Sprint 0.5.3)
# ---------------------------------------------------------------------------
# Supabase: Project Settings → Database → Connection pooling → "Session mode" (port 5432).
#
# IMPORTANT — use the POOLER URL, not the direct DB URL:
#   ✓ aws-X-REGION.pooler.supabase.com:5432   (works — IPv4 + IPv6)
#   ✗ db.PROJECT.supabase.co:5432             (IPv6-only on new projects; usually unreachable)
#
# Note that the username on the pooler is `postgres.PROJECT_REF`, not just `postgres`.
# Why Session mode (5432) over Transaction mode (6543): Alembic uses session-level
# features (set lock_timeout, etc.) that the transaction pooler does not support.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-X-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Redis (Sprint 0.5.5) — Celery broker + result backend
# ---------------------------------------------------------------------------
# Local Docker via docker-compose.yml. Host port 6380 because 6379 may be in
# use by other projects on the same machine. The trailing `/0` selects logical
# database 0 (Redis has 16 numbered DBs per instance for isolation).
# In prod: managed Redis (Upstash, Redis Cloud, GCP Memorystore, etc.).
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------------------
# Auth + identity (Sprint 1)
# ---------------------------------------------------------------------------
# JWT_SECRET MUST match AUTH_SECRET in apps/web/.env.local (ADR-0009).
JWT_SECRET=

# Unset in production. If a signed-in user's email matches this, the /me
# endpoint reports an effectively-infinite balance — purely a dev convenience.
# DEV_EMAIL=

# New users start with this credit balance. Default 0 = cold-start UX.
# FREE_STARTER_CREDITS=0

# ---------------------------------------------------------------------------
# CORS + return URLs (Sprint 7 deploy-relevant)
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed by FastAPI's CORSMiddleware.
# Same list is also used by `scripts/setup_r2_cors.py` for the R2 bucket
# CORS rule. In prod, add the deployed frontend domain (no trailing slash).
# Example: CORS_ALLOWED_ORIGINS=https://img-vid-generation.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where Stripe sends the browser after Checkout (success/cancel paths
# appended automatically by app/routers/billing.py). In prod: the deployed
# frontend root URL.
CHECKOUT_RETURN_URL_BASE=http://localhost:3000

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Google AI Studio (Sprint 2). Free tier; get a key at
# https://aistudio.google.com/apikey. Sprint 7+ may migrate to Vertex AI
# (which uses GCP IAM instead).
# GOOGLE_API_KEY=

# Seegen.ai (Sprint 3.5.1). $-paid; 200-credit free signup.
# SEEGEN_API_KEY=

# Cloudflare Workers AI (Sprint 6.5). Free ~25-100 imgs/day. Token must be
# scoped to "Workers AI: Read" — separate from the R2 token below.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage (Sprint 4A)
# ---------------------------------------------------------------------------
# S3-compatible — boto3 against the R2 endpoint. The PUBLIC_URL is the
# r2.dev subdomain (Bucket → Settings → Public Access → R2.dev subdomain),
# what the browser uses to render result images.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=img-vid-generation-dev
# R2_PUBLIC_URL=https://pub-<HASH>.r2.dev

# ---------------------------------------------------------------------------
# Stripe credit packs (Sprint 5)
# ---------------------------------------------------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Webhook
# secret is per-environment: locally it's the `whsec_...` printed by
# `stripe listen`; in prod it's set per webhook endpoint in the dashboard.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_STARTER=          # 100 credits / $5
# STRIPE_PRICE_ID_PRO=              # 500 credits / $20
# STRIPE_PRICE_ID_STUDIO=           # 2000 credits / $60

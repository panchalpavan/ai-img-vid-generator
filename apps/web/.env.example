# Copy this file to `.env.local` (gitignored) and fill in real values.
# Do NOT commit secrets.

# ---------------------------------------------------------------------------
# Auth.js (Sprint 1.1)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# MUST match JWT_SECRET in apps/api/.env so FastAPI can verify Auth.js tokens.
AUTH_SECRET=

# Base URL the app is served on. In dev this is the Next.js dev server.
AUTH_URL=http://localhost:3000

# Google OAuth credentials from Google Cloud Console → OAuth Client ID.
# These specific env var names are auto-detected by Auth.js v5's Google provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Backend URL (Sprint 1.5)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ prefix exposes the value to client-side JS. Safe — this is not
# a secret, just the address the browser uses to call the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

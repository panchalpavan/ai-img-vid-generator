{
  "name": "img-vid-generation",
  "version": "0.1.0",
  "private": true,
  "description": "AI image and video generation app — Next.js frontend + FastAPI backend monorepo",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "uv --directory apps/api run uvicorn app.main:app --reload --port 8000",
    "build": "npm run build:web",
    "build:web": "npm --workspace apps/web run build",
    "start:web": "npm --workspace apps/web run start",
    "lint": "npm run lint:web && npm run lint:api",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "uv --directory apps/api run ruff check .",
    "format:api": "uv --directory apps/api run ruff format .",
    "typecheck:api": "uv --directory apps/api run mypy app",
    "test:api": "uv --directory apps/api run pytest"
  }
}
